#!desc=Duo Super
#!homepage=https://firecore.com/infuse
#!author=nkr00711
#!icon=https://raw.githubusercontent.com/LegoIsFunny/InfusePlus/refs/heads/main/Resources/icon.png
name: Duolingo
desc: Unlock Duo
http:
  mitm:
    - "*duolingo.com"
  script:
    - match: ^https:\/\/(ios-api-2|goals-api|ios-api-cf)\.duolingo\.com\/.*users.*
      name: DuoUnlocker
      type: response
      require-body: true
      timeout: 10
script-providers:
  DuoUnlocker:
    url: https://raw.githubusercontent.com/dhungx/modules-shadowrocket/refs/heads/main/js/duolingo/super.js
    interval: 86400
