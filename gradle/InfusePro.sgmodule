[Script]
# Infuse
# hostname = api.trakt.tv
InfusePro = type=http-response,pattern=^https:\/\/api\.trakt\.tv\/storage,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/NKR00711/Virtual-Hosts/refs/heads/master/gradle/wrapper/trakt_infuse_NKR1.js
Infuse = type=http-response,pattern=^https:\/\/api\.trakt\.tv\/users\/settings,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/NKR00711/Virtual-Hosts/refs/heads/master/gradle/wrapper/trakt_infuse_FreeIDMZone1.js

[MITM]
hostname = %APPEND% api.trakt.tv
