name: Infuse
desc: Unlock Infuse Pro Using Trakt
http:
  mitm:
    - "api.trakt.tv"
  script:
    - match: ^https:\/\/api\.trakt\.tv\/storage
      name: InfuseTraktPro
      type: response
      require-body: true
      timeout: 0
script-providers:
  InfuseTraktPro:
    url: https://raw.githubusercontent.com/NKR00711/Virtual-Hosts/refs/heads/master/gradle/wrapper/trakt_infuse.js
    interval: 86400
